<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PYTHONIOENCODING</key>
		<string>utf-8</string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
	</dict>
	<key>ExitTimeOut</key>
	<integer>15</integer>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>Label</key>
	<string>com.fst.ricoh-stock-monitor</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>__HOME__/Library/Application Support/RicohStockMonitor/service_runner.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Application Support/RicohStockMonitor/logs/bootstrap.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Application Support/RicohStockMonitor/logs/bootstrap.log</string>
	<key>ThrottleInterval</key>
	<integer>60</integer>
	<key>Umask</key>
	<integer>63</integer>
	<key>WorkingDirectory</key>
	<string>__HOME__/Library/Application Support/RicohStockMonitor</string>
</dict>
</plist>
